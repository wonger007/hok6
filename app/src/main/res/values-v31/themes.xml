<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: its own splash on the same red, with the same icon, before Hok6's splash takes over. -->
    <style name="Theme.StudyBook.Launch" parent="Theme.StudyBook">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
    </style>
</resources>
