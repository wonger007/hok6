<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/audio_prev"
        style="@style/PlayerButton"
        android:contentDescription="@string/previous"
        android:src="@drawable/ic_prev" />

    <ImageButton
        android:id="@+id/audio_back"
        style="@style/PlayerButton"
        android:contentDescription="@string/back_5"
        android:src="@drawable/ic_replay" />

    <ImageButton
        android:id="@+id/audio_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_pause"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        app:tint="@color/brand_text" />

    <ImageButton
        android:id="@+id/audio_next"
        style="@style/PlayerButton"
        android:contentDescription="@string/next"
        android:src="@drawable/ic_next" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/audio_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/audio_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:progressDrawable="@drawable/seek_track"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <TextView
            android:id="@+id/audio_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/audio_speed"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/speed"
        android:minWidth="64dp" />

    <ImageButton
        android:id="@+id/audio_repeat"
        style="@style/PlayerButton"
        android:contentDescription="@string/repeat_one"
        android:src="@drawable/ic_repeat_one" />

    <ImageButton
        android:id="@+id/audio_close"
        style="@style/PlayerButton"
        android:contentDescription="@string/close_player"
        android:src="@drawable/ic_close" />
</LinearLayout>
