<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8: nothing goes to the Google Drive backup (Hok6 keeps its own backup file in the book folder; see
     AutoBackup). Android 8 can't tell a backup from a move to a new device, so neither is used (see xml-v28). -->
<full-backup-content>
    <!-- Only this file, which never exists, so nothing is backed up. -->
    <include domain="file" path="no-backup" />
</full-backup-content>
