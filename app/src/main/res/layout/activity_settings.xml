<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/setup_side"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/setup_side"
        android:paddingBottom="24dp">

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_downloads" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:alpha="0.7"
            android:text="@string/setup_intro"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/settings_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/loading"
            android:indeterminate="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/download_all" />

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_reminders" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settings_remind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/settings_remind"
            android:textSize="16sp" />

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/appearance_title" />

        <RadioGroup
            android:id="@+id/settings_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/look_system"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/appearance_system"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/look_light"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/appearance_light"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/look_dark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/appearance_dark"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_welcome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_show_welcome"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_welcome" />
    </LinearLayout>
</ScrollView>
