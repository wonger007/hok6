<resources>
    <style name="Theme.StudyBook" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">#C17900</item>
        <item name="colorOnSecondary">#000000</item>
    </style>

    <!-- The main screen while Hok6 starts; it switches to Theme.StudyBook once it's running. -->
    <style name="Theme.StudyBook.Launch" parent="Theme.StudyBook">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>

    <style name="Theme.StudyBook.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Selecting files shows its bar over the title bar, not above it. -->
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
    </style>

    <style name="PlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">?attr/colorControlNormal</item>
    </style>

    <!-- Tools in the title bar of the chapter screen -->
    <style name="BarButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bar_button</item>
        <item name="android:scaleType">center</item>
        <item name="tint">?attr/colorOnPrimarySurface</item>
    </style>

    <style name="BarTextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bar_button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">?attr/colorOnPrimarySurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
