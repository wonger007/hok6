<resources>
    <style name="Theme.StudyBook" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Switches, radio buttons and seek bars: the same red as the rest (amber was hard to see on white). -->
        <item name="colorSecondary">@color/brand_text</item>
        <item name="colorSecondaryVariant">@color/brand_dark</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- The title bar stays red in dark mode too (a deeper red), rather than turning grey. -->
        <item name="colorPrimarySurface">@color/bar</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bar_status</item>
        <item name="actionBarStyle">@style/HokActionBar</item>
    </style>

    <!-- The title bar of screens with Android's own bar (the folder cards, Settings): red, deeper red in dark mode. -->
    <style name="HokActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/bar</item>
    </style>

    <!-- The main screen while Hok6 starts; it switches to Theme.StudyBook once it's running. -->
    <style name="Theme.StudyBook.Launch" parent="Theme.StudyBook">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>

    <style name="Theme.StudyBook.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Selecting files shows its bar over the title bar, not above it. -->
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand_text</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorPrimarySurface">@color/bar</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bar_status</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textSize">@dimen/text_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="PlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">?attr/colorControlNormal</item>
    </style>

    <!-- Tools in the title bar of the chapter screen -->
    <style name="BarButton">
        <item name="android:layout_width">@dimen/bar_button</item>
        <item name="android:layout_height">@dimen/bar_button</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bar_button</item>
        <item name="android:scaleType">center</item>
        <item name="tint">?attr/colorOnPrimarySurface</item>
    </style>

    <style name="BarTextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/bar_button</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bar_button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">?attr/colorOnPrimarySurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
